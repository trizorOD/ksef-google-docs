# KSeF Configuration
KSEF_BASE_URL=
KSEF_NIP=
KSEF_TOKEN=

# Google Sheets Configuration
GOOGLE_SHEET_ID=
# Path to Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# SMTP (email reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
