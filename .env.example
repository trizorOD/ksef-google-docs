# TEMPORARY testing safety valve — comma-separated email addresses. If set,
# reminder emails are only actually sent to these addresses; every other
# match is skipped and logged. Remove/unset to send to all matched Contacts.
REMINDERS_TEST_ONLY_RECIPIENTS=

# Start date for initial sync (ISO format)
SYNC_START_DATE=

# Server
PORT=